<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  FULL REGRESSION — every test class across Modules 0-14 plus Exports.
  Runs against staging (base.url in config.properties); many tests create QA- tagged records.

  Parallel by class. BrowserManager reuses one Chromium per thread (fresh isolated context per
  test). thread-count=2 keeps CPU headroom so headless Chromium stays responsive — at 4, sustained
  saturation caused SPA net::ERR_ABORTED / timeout flakes that moved between tests each run. Raise
  this only on a powerful, otherwise-idle machine.
-->
<suite name="Logistics TMS Regression Suite" parallel="classes" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <!-- Auto-retry transient failures (shared-staging SPA nav races / timing) up to 2x. -->
        <listener class-name="com.portfolio.logistics.retry.RetryTransformer"/><listener class-name="com.portfolio.logistics.retry.RetryReportCleaner"/>
    </listeners>

    <test name="Module 00 - Smoke / Environment">
        <classes>
            <class name="com.portfolio.logistics.tests.smoke.SmokeTest"/>
        </classes>
    </test>

    <test name="Module 01 - Auth &amp; Roles">
        <classes>
            <class name="com.portfolio.logistics.tests.auth.AuthTest"/>
            <class name="com.portfolio.logistics.tests.roles.RoleLoginTest"/>
            <class name="com.portfolio.logistics.tests.roles.RoleAccessControlTest"/>
        </classes>
    </test>

    <test name="Module 01 - Roles (Functional)">
