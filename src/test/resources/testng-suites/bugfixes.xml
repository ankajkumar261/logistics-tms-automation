<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Bug Fixes (verify dev fixes)" parallel="classes" thread-count="1" verbose="1">
    <listeners><listener class-name="io.qameta.allure.testng.AllureTestNg"/><listener class-name="com.portfolio.logistics.retry.RetryTransformer"/><listener class-name="com.portfolio.logistics.retry.RetryReportCleaner"/></listeners>
    <test name="Bug fixes">
        <classes>
            <class name="com.portfolio.logistics.tests.bugfixes.ForgotPasswordTest"/>
            <class name="com.portfolio.logistics.tests.bugfixes.ReportsCalendarFilterTest"/>
            <class name="com.portfolio.logistics.tests.bugfixes.AdminImportTemplateTest"/>
            <class name="com.portfolio.logistics.tests.roles.reports.ReportsRoleDateFilterTest"/>
        </classes>
    </test>

    <!-- Regression cover for the seven manually-reported defects. -->
    <test name="Reported defects (FIX-01..07)">
        <classes>
            <class name="com.portfolio.logistics.tests.bugfixes.AssetTrackingMissingCoordinatesTest"/>
            <class name="com.portfolio.logistics.tests.bugfixes.TruckLicensePlateTest"/>
            <class name="com.portfolio.logistics.tests.bugfixes.DriverLicenseExpiryTest"/>
            <class name="com.portfolio.logistics.tests.bugfixes.EmployeeCreationTest"/>
            <class name="com.portfolio.logistics.tests.bugfixes.TaxCodeOptionalRegionTest"/>
            <class name="com.portfolio.logistics.tests.bugfixes.EldProviderMotiveTest"/>
            <class name="com.portfolio.logistics.tests.bugfixes.BlogPostsLoadingTest"/>
        </classes>
    </test>
</suite>
