<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Role - REPORTS" parallel="classes" thread-count="1" verbose="1">
    <listeners><listener class-name="io.qameta.allure.testng.AllureTestNg"/><listener class-name="com.portfolio.logistics.retry.RetryTransformer"/><listener class-name="com.portfolio.logistics.retry.RetryReportCleaner"/></listeners>
    <!-- REPORTS = Reports only (login confirmed working 2026-07-17). -->
    <test name="REPORTS - access">
        <classes>
            <class name="com.portfolio.logistics.tests.roles.RoleAccessControlTest">
                <methods><include name="reportsAccess"/></methods>
            </class>
        </classes>
    </test>
    <test name="REPORTS - functional">
        <classes><class name="com.portfolio.logistics.tests.roles.reports.ReportsFunctionalTest"/>
            <class name="com.portfolio.logistics.tests.roles.reports.ReportsRoleDateFilterTest"/></classes>
    </test>
</suite>
