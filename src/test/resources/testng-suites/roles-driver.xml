<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Role - DRIVER" parallel="classes" thread-count="1" verbose="1">
    <listeners><listener class-name="io.qameta.allure.testng.AllureTestNg"/><listener class-name="com.portfolio.logistics.retry.RetryTransformer"/><listener class-name="com.portfolio.logistics.retry.RetryReportCleaner"/></listeners>
    <test name="DRIVER - access">
        <classes>
            <class name="com.portfolio.logistics.tests.roles.RoleAccessControlTest">
                <methods><include name="driverAccess"/></methods>
            </class>
        </classes>
    </test>
    <test name="DRIVER - functional">
        <classes><class name="com.portfolio.logistics.tests.roles.driver.DriverTripsTest"/></classes>
    </test>
</suite>
